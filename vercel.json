{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/rpc",
      "destination": "https://script.google.com/macros/s/AKfycbxs6VSf80M7-PQN60JNYqzBM2U_MUxj2DZA1zhOylYsMKTMcqw5VedrOGEMgi92cAu36Q/exec"
    }
  ],
  "headers": [
    {
      "source": "/api/rpc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/native-location",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
