{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/rpc",
      "destination": "https://script.google.com/macros/s/AKfycbyVCYKiI7T7vCFdzvlSq6Z67etbf9siph1I0PdMkTIm5UjL0gaS3crnfU8km3Hb7CU4zA/exec"
    }
  ],
  "headers": [
    {
      "source": "/api/rpc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/native-location",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
