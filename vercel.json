{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/rpc",
      "destination": "https://script.google.com/macros/s/AKfycbw8WedGItXJ7OjDyetD2BbgnA88BWSK2YZ7se7jvivjJ5V6UZfNy6fOrJxLOXZCSeE3gg/exec"
    }
  ],
  "headers": [
    {
      "source": "/api/rpc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/native-location",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
