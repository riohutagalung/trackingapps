{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/rpc",
      "destination": "https://script.google.com/macros/s/AKfycbxaQw9ZoU5hvV_zzO8HY-R0LbD9MBlqVmkSwBUeReE_-TJgkja9LQvaplWa-WYVF51QyQ/exec"
    }
  ],
  "headers": [
    {
      "source": "/api/rpc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/native-location",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}