function getRouteSuggestion(direction) {
  var origin = direction === 'home-office' ? HOME_CONFIG : OFFICE_CONFIG;
  var destination = direction === 'home-office' ? OFFICE_CONFIG : HOME_CONFIG;

  return {
    traffic: fetchRealtimeRoutes_(origin, destination),
    habits: getRouteHabits()
  };
}

function buildBestRouteRecommendation_(origin,destination,habits,trips){
  var exact=(habits||[]).filter(function(h){return String(h.origin)===String(origin.name)&&String(h.destination)===String(destination.name);}).sort(function(a,b){return Number(b.freq||0)-Number(a.freq||0);})[0];
  var recent=(trips||[]).filter(function(t){return String(t.origin)===String(origin.name)&&String(t.destination)===String(destination.name);}).slice(0,20);
  var ds=recent.map(function(t){return Number(t.durationMin||0);}).filter(function(x){return x>0;}).sort(function(a,b){return a-b;});
  var avg=ds.length?ds.reduce(function(a,b){return a+b;},0)/ds.length:(exact?Number(exact.avgDur||0):0);
  var median=ds.length?(ds.length%2?ds[(ds.length-1)/2]:(ds[ds.length/2-1]+ds[ds.length/2])/2):avg;
  var km=recent.length?recent.reduce(function(a,t){return a+Number(t.distanceKm||0);},0)/recent.length:(exact?Number(exact.avgDistance||0):0);
  return {hasHistory:!!(exact||recent.length),routeName:(exact&&exact.routeName)||origin.name+' → '+destination.name,frequency:(exact&&exact.freq)||recent.length,avgDuration:avg,personalMedianDuration:median,avgDistance:km,personalAdjustmentMin:null,message:exact?'Habit utama: '+(exact.routeName||'rute ini')+' • '+(exact.freq||0)+'x • baseline '+avg.toFixed(1)+' menit.':recent.length?'Baseline pribadi dari '+recent.length+' trip terakhir: '+avg.toFixed(1)+' menit.':'Belum ada habit rute yang cukup.'};
}

function fetchRealtimeRoutes_(origin, destination) {
  var apiKey = getTrafficApiKey_();
  var mapsUrl = 'https://www.google.com/maps/dir/?api=1'
    + '&origin=' + encodeURIComponent(origin.address || (origin.lat + ',' + origin.lng))
    + '&destination=' + encodeURIComponent(destination.address || (destination.lat + ',' + destination.lng))
    + '&travelmode=driving';

  // 1) Kalau API key traffic sudah dikonfigurasi, coba Routes API dulu
  //    (paling akurat, sudah memperhitungkan macet real-time).
  if (apiKey) {
    var apiResult = tryRoutesApi_(origin, destination, apiKey, mapsUrl);
    if (apiResult) return apiResult;
    // kalau gagal, lanjut ke fallback di bawah — jangan biarkan kosong
  }

  // 2) Fallback: Apps Script Maps service BAWAAN (gratis, tanpa API key,
  //    tanpa setup apapun) — ini yang bikin "Cek ke Kantor / Cek Pulang"
  //    selalu kasih estimasi jarak & waktu walau kamu belum sempat isi
  //    API key sama sekali.
  var fallback = tryBuiltinMaps_(origin, destination, mapsUrl);
  if (fallback) return fallback;

  // 3) Kalau dua-duanya gagal (jarang, biasanya krn tidak ada koneksi),
  //    baru kasih link Maps polos tanpa angka.
  return {
    ok: true,
    mode: 'direct_maps',
    origin: origin.name,
    destination: destination.name,
    mapsUrl: mapsUrl,
    message: 'Tidak bisa menghitung estimasi otomatis saat ini. Buka Google Maps langsung.'
  };
}

function tryRoutesApi_(origin, destination, apiKey, mapsUrl) {
  try {
    var body = {
      origin: {location: {latLng: {latitude: origin.lat, longitude: origin.lng}}},
      destination: {location: {latLng: {latitude: destination.lat, longitude: destination.lng}}},
      travelMode: 'DRIVE',
      routingPreference: 'TRAFFIC_AWARE',
      computeAlternativeRoutes: true,
      languageCode: 'id-ID',
      units: 'METRIC'
    };

    var res = UrlFetchApp.fetch('https://routes.googleapis.com/directions/v2:computeRoutes', {
      method: 'post',
      contentType: 'application/json',
      headers: {
        'X-Goog-Api-Key': apiKey,
        'X-Goog-FieldMask': 'routes.duration,routes.staticDuration,routes.distanceMeters,routes.description'
      },
      payload: JSON.stringify(body),
      muteHttpExceptions: true
    });

    var parsed = JSON.parse(res.getContentText());
    if (res.getResponseCode() !== 200 || !parsed.routes || !parsed.routes.length) return null;

    var routes = parsed.routes.map(function(r) {
      var durSec = parseInt(String(r.duration || '0s').replace('s', ''), 10);
      var staticSec = parseInt(String(r.staticDuration || r.duration || '0s').replace('s', ''), 10);
      return {
        description: r.description || 'Rute standar',
        distanceKm: Math.round((r.distanceMeters || 0) / 100) / 10,
        durationMin: Math.round(durSec / 60),
        trafficDelayMin: Math.max(0, Math.round((durSec - staticSec) / 60))
      };
    }).sort(function(a, b) { return a.durationMin - b.durationMin; });

    var embedUrl = 'https://www.google.com/maps/embed/v1/directions?key=' + apiKey +
                   '&origin=' + encodeURIComponent(origin.lat + ',' + origin.lng) +
                   '&destination=' + encodeURIComponent(destination.lat + ',' + destination.lng);

    return {
      ok: true, mode: 'api', origin: origin.name, destination: destination.name,
      routes: routes, mapsUrl: mapsUrl, embedUrl: embedUrl, trafficAware: true
    };
  } catch (e) {
    return null;
  }
}

function tryBuiltinMaps_(origin, destination, mapsUrl) {
  try {
    var directions = Maps.newDirectionsFinder()
      .setOrigin(origin.lat, origin.lng)
      .setDestination(destination.lat, destination.lng)
      .setMode(Maps.DirectionMode.DRIVING)
      .getDirections();

    if (!directions.routes || !directions.routes.length) return null;

    var leg = directions.routes[0].legs[0];
    var routes = [{
      description: 'Rute tercepat',
      distanceKm: Math.round((leg.distance.value || 0) / 100) / 10,
      durationMin: Math.round((leg.duration.value || 0) / 60),
      trafficDelayMin: 0
    }];

    return {
      ok: true, mode: 'builtin', origin: origin.name, destination: destination.name,
      routes: routes, mapsUrl: mapsUrl, trafficAware: false,
      message: 'Estimasi dari Google Maps (tanpa data macet real-time). Tambahkan Google Routes API key di Pengaturan untuk estimasi yang memperhitungkan macet.'
    };
  } catch (e) {
    return null;
  }
}


