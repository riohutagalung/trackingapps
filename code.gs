  var amount=fuel.reduce(function(s,e){return s+Number(e.amount||0);},0), liters=fuel.reduce(function(s,e){return s+Number(e.liters||0);},0), distance=0,moving=0,consumed=0;
  (trips||[]).forEach(function(t){if(t.date<weekStart||t.date>today)return;distance+=Number(t.distanceKm||0);moving+=Number(t.movingTimeMin||t.durationMin||0);var eff=getBestEfficiencyForTrip_(t,insight);if(eff>0)consumed+=Number(t.distanceKm||0)/eff;});
  var avg=consumed>0?distance/consumed:0; return {amount:amount,liters:liters,transactionCount:fuel.length,distanceKm:distance,movingMin:moving,estimatedLitersUsed:consumed,avgKmL:avg,avgFuelPricePerL:liters>0?amount/liters:0,costPerKm:distance>0?amount/distance:0};
