function ss_() {
  return SpreadsheetApp.openById(SHEET_ID);
}

function tab_(name, headers) {
  var sheet = ss_().getSheetByName(name);
  if (!sheet) throw new Error('Sheet "' + name + '" tidak ditemukan. Tidak ada Sheet baru yang dibuat otomatis.');
  return sheet;
}

function dateStr_(value) {
  if (value instanceof Date) {
    return Utilities.formatDate(value, TZ, 'yyyy-MM-dd');
  }

  return String(value || '');
}

function todayStr_() {
  return Utilities.formatDate(
    new Date(),
    TZ,
    'yyyy-MM-dd'
  );
}

function nowISO_() {
  return new Date().toISOString();
}

/* ===============================================================
   SETTINGS
=============================================================== */

const SETTING_HEADERS = [
  'Key',
  'Value'
];

function getSettings() {
  var sheet = tab_(
    'Settings',
    SETTING_HEADERS
  );

  if (sheet.getLastRow() <= 1) {
    return {};
  }

  var rows = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      2
    )
    .getValues();

  var output = {};

  rows.forEach(function(row) {
    var key = row[0];
    var value = row[1];

    try {
      output[key] = JSON.parse(value);
    } catch (e) {
      output[key] = value;
    }
  });

  return output;
}

function saveSetting(key, value) {
  var sheet = tab_(
    'Settings',
    SETTING_HEADERS
  );

  var rows = sheet
    .getDataRange()
    .getValues();

  var serialized = JSON.stringify(value);

  for (
    var i = 1;
    i < rows.length;
    i++
  ) {
    if (String(rows[i][0]) === String(key)) {
      sheet
        .getRange(
          i + 1,
          2
        )
        .setValue(serialized);

      return {
        ok: true
      };
    }
  }

  sheet.appendRow([
    key,
    serialized
  ]);

  return {
    ok: true
  };
}

