function calculateHabitStreak_(expenses, trips) {
  var dates = {};
  (expenses || []).forEach(function(e) { if (e.date) dates[e.date] = true; });
  (trips || []).forEach(function(t) { if (t.date) dates[t.date] = true; });
  var streak = 0;
  var d = new Date();
  for (var i = 0; i < 120; i++) {
    var key = Utilities.formatDate(d, TZ, 'yyyy-MM-dd');
    if (!dates[key]) break;
    streak++;
    d.setDate(d.getDate() - 1);
  }
  return {days: streak, lastActivity: Object.keys(dates).sort().pop() || ''};
}

