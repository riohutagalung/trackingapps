function getCachedOrBuildDailyInsight_(expenses,trips){try{var raw=CacheService.getScriptCache().get('rh_insight_v9');if(raw)return JSON.parse(raw);}catch(e){}var obj=buildDailyInsightObject_(expenses,trips);try{CacheService.getScriptCache().put('rh_insight_v9',JSON.stringify(obj),300);}catch(e){}return obj;}
