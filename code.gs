function getCommuteWeather() {
  var cache = CacheService.getScriptCache();
  var cached = cache.get('rh_habits_weather_v2');
  if (cached) { try { var cachedObj = JSON.parse(cached); if (!cachedObj.summary) cachedObj.summary = summarizeCommuteWeather_(cachedObj); return cachedObj; } catch (e) {} }

  var locations = [HOME_CONFIG, OFFICE_CONFIG];
  var result = {ok: true, generatedAt: nowISO_(), locations: {}};
  locations.forEach(function(loc) {
    var url = 'https://api.open-meteo.com/v1/forecast'
      + '?latitude=' + encodeURIComponent(loc.lat)
      + '&longitude=' + encodeURIComponent(loc.lng)
      + '&hourly=precipitation_probability,precipitation,weather_code'
      + '&forecast_days=2&timezone=' + encodeURIComponent(TZ);
    try {
      var res = UrlFetchApp.fetch(url, {muteHttpExceptions:true});
      if (res.getResponseCode() < 200 || res.getResponseCode() >= 300) throw new Error('Weather HTTP ' + res.getResponseCode());
      var data = JSON.parse(res.getContentText());
      result.locations[loc.name] = {name: loc.name, hours: data.hourly && data.hourly.time ? data.hourly.time.map(function(t, i) {
        return {time:t, probability:Number((data.hourly.precipitation_probability || [])[i] || 0), precipitation:Number((data.hourly.precipitation || [])[i] || 0), code:Number((data.hourly.weather_code || [])[i] || 0)};
      }) : []};
    } catch (e) {
      result.locations[loc.name] = {name: loc.name, hours: [], error:e.message};
    }
  });
  result.summary = summarizeCommuteWeather_(result);
  cache.put('rh_habits_weather_v2', JSON.stringify(result), 1200);
  return result;
}

function weatherForHour_(hours, dayOffset, hour) {
  var target = new Date();
  target.setHours(hour, 0, 0, 0);
  target.setDate(target.getDate() + (dayOffset || 0));
  var key = Utilities.formatDate(target, TZ, "yyyy-MM-dd'T'HH:00");
  for (var i = 0; i < hours.length; i++) if (String(hours[i].time).indexOf(key) === 0) return hours[i];
  return null;
}

function summarizeCommuteWeather_(weather) {
  var now = new Date();
  var hour = Number(Utilities.formatDate(now, TZ, 'H'));
  var morningOffset = hour < 7 ? 0 : 1;
  var eveningOffset = hour < 18 ? 0 : 1;
  var home = weather.locations[HOME_CONFIG.name] || {hours:[]};
  var office = weather.locations[OFFICE_CONFIG.name] || {hours:[]};
  var m1 = weatherForHour_(home.hours, morningOffset, 7), m2 = weatherForHour_(office.hours, morningOffset, 7);
  var e1 = weatherForHour_(home.hours, eveningOffset, 18), e2 = weatherForHour_(office.hours, eveningOffset, 18);
  function pack(a,b,label) {
    var p = Math.max(a ? a.probability : 0, b ? b.probability : 0);
    var mm = Math.max(a ? a.precipitation : 0, b ? b.precipitation : 0);
    return {label:label, probability:p, precipitation:mm, caution:p >= 60 || mm > 0.5};
  }
  return {morning:pack(m1,m2,'Pagi'), evening:pack(e1,e2,'Sore')};
}

