  var settings=getSettings();
  return settings.fuelPriceRegistry && typeof settings.fuelPriceRegistry==='object' ? settings.fuelPriceRegistry : defaults;
}
function getFuelReferencePrice_(gradeOrText,dateStr){
  var registry=buildFuelPriceRegistry_(), key=detectFuelGrade_(String(gradeOrText||'').toLowerCase()) || String(gradeOrText||'');
  if(registry[key])return registry[key];
  var keys=Object.keys(registry); for(var i=0;i<keys.length;i++){if(normalizeText_(key)===normalizeText_(keys[i]))return registry[keys[i]];}
  return {price:0,effectiveDate:'',source:''};
}
function saveFuelReferencePrice(grade,price,effectiveDate,source){
  var registry=buildFuelPriceRegistry_(); registry[String(grade)]= {price:Number(price||0),effectiveDate:String(effectiveDate||todayStr_()),source:String(source||'manual')}; saveSetting('fuelPriceRegistry',registry); return {ok:true,registry:registry};
}
