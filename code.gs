];

function addTrip(data) {
  data = data || {};
  var sheet = tab_('Trips', TRIP_H);
  ensureTripColumns_(sheet); // only on write
  var headers = sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0];
  var map = getHeaderMap_(headers);
  var id = data.id || Utilities.getUuid().slice(0,8);
  var distanceKm = Math.max(0, Number(data.distanceKm || 0));
  var durationMin = Math.max(0, Number(data.durationMin || 0));
  var avgSpeed = Math.max(0, Number(data.avgSpeed || 0));
  var maxSpeed = Math.max(0, Number(data.maxSpeed || 0));
  var movingTimeMin = Math.max(0, Number(data.movingTimeMin || 0));
  var stopTimeMin = Math.max(0, Number(data.stopTimeMin || Math.max(0, durationMin-movingTimeMin)));
  var stopCount = Math.max(0, Number(data.stopCount || 0));
  var startTime = data.startTime || nowISO_();
  var endTime = data.endTime || nowISO_();
  var routeName = data.routeName || generateRouteName_(data.origin, data.destination, data.note);
  var gpsPoints = Array.isArray(data.gpsPoints) ? compressGpsPoints_(data.gpsPoints) : [];
  var variant = data.routeVariant || makeRouteVariantSignature_(gpsPoints.length ? gpsPoints : data.gpsPoints);
  var fuelGrade = String(data.fuelGrade || '');
  var fuelEff = Number(data.fuelEfficiency || 0);
  var fuelEstL = Number(data.fuelEstimatedL || (fuelEff>0 ? distanceKm/fuelEff : 0));
  var fuelEstCost = Number(data.fuelEstimatedCost || 0);
  var values = {
    'ID':id,'Tanggal':data.date||todayStr_(),'Asal':data.origin||'GPS Track','Tujuan':data.destination||'Tujuan','Jarak_km':distanceKm,'Durasi_menit':durationMin,'AvgSpeed_kmh':avgSpeed,
    'Catatan':data.note||'','Sumber':data.source||'gps','Timestamp':nowISO_(),'RouteName':routeName,'MaxSpeed_kmh':maxSpeed,'GPSPoints':JSON.stringify(gpsPoints),
    'StartTime':startTime,'EndTime':endTime,'Kendaraan':data.vehicle||'Motor','MovingTime_menit':movingTimeMin,'StopTime_menit':stopTimeMin,'StopCount':stopCount,
    'RouteVariant':variant,'FuelGrade':fuelGrade,'FuelEfficiency_kmL':fuelEff,'FuelEstimated_L':fuelEstL,'FuelEstimatedCost':fuelEstCost
  };
  var row = new Array(headers.length).fill('');
  Object.keys(values).forEach(function(k){ if(map[k]!==undefined) row[map[k]]=values[k]; });
  sheet.appendRow(row);
  try { var rr=sheet.getLastRow(); ['Jarak_km','Durasi_menit','AvgSpeed_kmh','MaxSpeed_kmh','MovingTime_menit','StopTime_menit','FuelEfficiency_kmL','FuelEstimated_L','FuelEstimatedCost'].forEach(function(k){if(map[k]!==undefined)sheet.getRange(rr,map[k]+1).setNumberFormat('0.00');}); } catch(e) {}
  if (data.origin && data.destination) updateRouteHabit_(data.origin,data.destination,durationMin,distanceKm,routeName,variant,movingTimeMin,stopTimeMin);
  // Calendar logging is intentionally opt-in for performance.
  try {
    var settings = getSettings();
    if (settings.calendarLogging === true) {
      var start = new Date(startTime), end = new Date(endTime);
      if (isNaN(start.getTime())) start=new Date();
      if (isNaN(end.getTime()) || end<=start) end=new Date(start.getTime()+Math.max(durationMin,1)*60000);
      var cal=CalendarApp.getCalendarById(CALENDAR_ID)||CalendarApp.getDefaultCalendar();
      cal.createEvent('🚗 '+routeName,start,end,{description:'RH Habits\n'+routeName+'\n'+distanceKm.toFixed(2)+' km • '+durationMin.toFixed(1)+' min'});
    }
  } catch(e) { Logger.log('Calendar opt-in error: '+e.message); }
  invalidateEngineCache_();
  var analysis = analyzeTripRecord_(values);
  return {ok:true,id:id,routeName:routeName,analysis:analysis};
}

function ensureTripColumns_(sheet) {
  var existing =
    sheet
      .getRange(1, 1, 1, sheet.getLastColumn())
      .getValues()[0];

  TRIP_H.forEach(function(header) {
    if (existing.indexOf(header) === -1) {
      sheet
        .getRange(1, sheet.getLastColumn() + 1)
        .setValue(header);
    }
  });
}

function getTrips(limit){ return getTripsFast_(limit || BOOT_TRIP_LIMIT); }

function deleteTrip(id) {
  var sheet = tab_('Trips', TRIP_H);
  var rows = sheet.getDataRange().getValues();

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][0]) === String(id)) {
      sheet.deleteRow(i + 1);
      return { ok: true };
    }
  }
  return { ok: false };
}

/* ===============================================================
   ROUTE HABITS
=============================================================== */

const ROUTE_H = [
  'Asal',
  'Tujuan',
  'Frekuensi',
  'AvgDurasi_menit',
  'AvgJarak_km',
  'RouteName',
  'LastUsed'
];

function updateRouteHabit_(origin, destination, duration, distance, routeName, routeVariant, movingTimeMin, stopTimeMin) {
  var sheet=tab_('Routes',ROUTE_H); ensureRouteColumns_(sheet);
  var headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0]; var map=getHeaderMap_(headers);
  var rows=sheet.getDataRange().getValues();
  for(var i=1;i<rows.length;i++){
    if(String(rows[i][map['Asal']])===String(origin)&&String(rows[i][map['Tujuan']])===String(destination)){
      var freq=Number(rows[i][map['Frekuensi']]||0)+1;
      var oldD=Number(rows[i][map['AvgDurasi_menit']]||0), oldK=Number(rows[i][map['AvgJarak_km']]||0);
      var avgD=((oldD*(freq-1))+Number(duration||0))/freq, avgK=((oldK*(freq-1))+Number(distance||0))/freq;
      if(map['Frekuensi']!==undefined) sheet.getRange(i+1,map['Frekuensi']+1).setValue(freq);
      if(map['AvgDurasi_menit']!==undefined) sheet.getRange(i+1,map['AvgDurasi_menit']+1).setValue(avgD);
      if(map['AvgJarak_km']!==undefined) sheet.getRange(i+1,map['AvgJarak_km']+1).setValue(avgK);
      if(map['RouteName']!==undefined) sheet.getRange(i+1,map['RouteName']+1).setValue(routeName||rows[i][map['RouteName']]);
      if(map['LastUsed']!==undefined) sheet.getRange(i+1,map['LastUsed']+1).setValue(nowISO_());
      return;
    }
  }
  var row=new Array(headers.length).fill('');
  var vals={'Asal':origin,'Tujuan':destination,'Frekuensi':1,'AvgDurasi_menit':Number(duration||0),'AvgJarak_km':Number(distance||0),'RouteName':routeName||'','LastUsed':nowISO_()};
  Object.keys(vals).forEach(function(k){if(map[k]!==undefined)row[map[k]]=vals[k];}); sheet.appendRow(row);
}

function ensureRouteColumns_(sheet) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  ROUTE_H.forEach(function(header) {
    if (headers.indexOf(header) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(header);
    }
  });
}

function getRouteHabits(){ return getRouteHabitsFast_(); }

/* ===============================================================
   ROUTE INTELLIGENCE
=============================================================== */

function getRouteIntelligence() {
  var trips = getTrips(100);
  var habits = getRouteHabits();

  return {
    habits: habits,
    recentTrips: trips.slice(0, 20),
    suggestions: buildRouteSuggestions_(habits, trips)
  };
}

function buildRouteSuggestions_(habits, trips) {
  var suggestions = [];
  habits.forEach(function(habit) {
    if (habit.freq >= 2) {
      suggestions.push({
        type: 'habit',
        routeName: habit.routeName,
        origin: habit.origin,
        destination: habit.destination,
        frequency: habit.freq,
        averageDuration: habit.avgDur,
        averageDistance: habit.avgDistance,
        message: habit.routeName
          ? 'Rute yang paling sering digunakan: ' + habit.routeName
          : 'Rute favorit berdasarkan ' + habit.freq + ' perjalanan'
      });
    }
  });
  return suggestions;
}

/* ===============================================================
   ROUTE NAME GENERATOR
=============================================================== */

function generateRouteName_(origin, destination, note) {
  var o = String(origin || '');
  var d = String(destination || '');
  var n = String(note || '');

  if (/bintaro/i.test(n)) return 'Rute Bintaro';
  if (/ciputat/i.test(n)) return 'Rute Ciputat';

  if (/pamulang/i.test(o) && /setiabudi|gama/i.test(d)) return 'Pamulang → Gama Tower';
  if (/setiabudi|gama/i.test(o) && /pamulang/i.test(d)) return 'Gama Tower → Pamulang';

  if (origin && destination) return origin + ' → ' + destination;
  return 'GPS Trip';
}

/* ===============================================================
   GPS POINT COMPRESSION
=============================================================== */

function compressGpsPoints_(points) {
  if (!Array.isArray(points)) return [];
  var output = [];
  points.forEach(function(point, index) {
    if (index === 0 || index === points.length - 1 || index % 5 === 0) {
      output.push({
        lat: Number(point.lat),
        lng: Number(point.lng),
        speed: Number(point.speed || 0),
        ts: point.ts || nowISO_()
      });
    }
  });
  return output;
}


function saveReceiptImage_(bytes, mimeType) {
  try {
    var folderName = 'RH Habits Receipts';
    var folders = DriveApp.getFoldersByName(folderName);
    var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(folderName);
    var fileName = 'struk_' + Utilities.formatDate(new Date(), TZ, 'yyyyMMdd_HHmmss') + '.jpg';
    var blob = Utilities.newBlob(bytes, mimeType || 'image/jpeg', fileName);
    var file = folder.createFile(blob);
    try { file.setDescription('RH Habits - bukti struk asli'); } catch (e) {}
    return {name: fileName, url: file.getUrl(), id: file.getId()};
  } catch (e) {
    Logger.log('Receipt save error: ' + e.message);
    return null;
  }
}

/* ===============================================================
   OCR (FIXED FOR DRIVE API v3)
=============================================================== */

function ocrImage(base64Data, mimeType) {
  var fileId = null;

  try {
    if (!base64Data) throw new Error('Data gambar kosong');

    // Filter string base64 jika terbawa prefix header data URL
    if (base64Data.indexOf(',') !== -1) {
      base64Data = base64Data.split(',')[1];
    }

    var bytes;
    try {
      bytes = Utilities.base64Decode(base64Data);
    } catch (e) {
      throw new Error('Format gambar tidak valid (base64 rusak)');
    }

    // Batas aman ~15MB byte asli — foto kamera resolusi tinggi bisa
    // besar; frontend sudah mengecilkan gambar sebelum upload, ini
    // jaring pengaman tambahan di server.
    if (bytes.length > 15 * 1024 * 1024) {
      throw new Error('Ukuran gambar terlalu besar untuk diproses OCR');
    }

    var blob = Utilities.newBlob(bytes, mimeType || 'image/jpeg', 'receipt_' + Date.now() + '.jpg');

    var fileResource = {
      name: 'OCR_TEMP_' + Date.now(),
      mimeType: 'application/vnd.google-apps.document'
    };

    var file;
    try {
      file = Drive.Files.create(fileResource, blob, {ocr: true, ocrLanguage: 'id'});
      fileId = file.id;
    } catch (e) {
      throw new Error('Gagal upload/konversi OCR di Google Drive: ' + (e.message || e));
    }

    // Foto struk fisik dari kamera HP biasanya lebih besar/detail
    // daripada screenshot e-banking, jadi butuh waktu OCR lebih lama.
    // Daripada sleep tetap 1 detik (sering belum selesai untuk foto
    // besar), coba beberapa kali dengan jeda bertambah sampai teksnya
    // benar-benar siap dibaca.
    var text = '';
    var attempts = [800, 1200, 2000, 3000];
    for (var i = 0; i < attempts.length; i++) {
      Utilities.sleep(attempts[i]);
      try {
        var doc = DocumentApp.openById(fileId);
        text = doc.getBody().getText();
      } catch (e) {
        text = '';
      }
      if (text && text.trim().length > 0) break;
    }

    // Hapus file Google Docs sementara dari Google Drive
    try {
      Drive.Files.remove(fileId);
    } catch (cleanupError) {
      try { DriveApp.getFileById(fileId).setTrashed(true); } catch (e2) {}
    }
    fileId = null;

    if (!text || !text.trim()) {
      return {
        ok: false,
        error: 'Foto berhasil diproses tapi tidak ada teks yang terbaca. Coba foto lebih jelas, cahaya cukup, dan struk tidak terpotong.'
      };
    }

    var parsed = parseReceiptText_(text);
    var receipt = saveReceiptImage_(bytes, mimeType);

    return {
      ok: true,
      text: text,
      parsed: parsed,
      receiptUrl: receipt ? receipt.url : ''
    };
  } catch (e) {
    // Bersihkan file sementara kalau masih ada walau terjadi error
    if (fileId) {
      try { Drive.Files.remove(fileId); } catch (e3) {
        try { DriveApp.getFileById(fileId).setTrashed(true); } catch (e4) {}
      }
    }
    return {
      ok: false,
      error: 'OCR Gagal: ' + (e.message || e.toString())
    };
  }
}

function analyzeReceipt(base64Data, mimeType) {
  return ocrImage(base64Data, mimeType);
}

/* ===============================================================
   RECEIPT PARSER (UPGRADED PARSER INTELIGEN)
=============================================================== */

function parseReceiptText_(text) {
  text = String(text || '');
  var lines = text.split(/\r?\n/)
    .map(function(line) { return normalizeOCRLine_(line); })
    .filter(function(line) { return line.length > 0; });

  var normalized = normalizeOCRText_(text);
  var lower = normalized.toLowerCase();
  var category = detectCategory_(lower);
  var fuelGrade = category === 'Bensin' ? detectFuelGrade_(lower) : '';
  var date = detectTransactionDate_(lines, normalized) || todayStr_();
  var currency = detectCurrency_(lines, normalized);
  var amountInfo = detectAmountSmart_(lines, normalized, currency);
  var recipient = detectRecipient_(lines, normalized);
  if (recipient && category !== 'Bensin') category = 'Lainnya';
  var merchant = detectMerchantSmart_(lines, normalized);
  var extractedItems = extractDetailedItems_(lines);
  var detailBits = [];

  if (fuelGrade) detailBits.push(fuelGrade);
  if (!fuelGrade && extractedItems.length) detailBits.push(extractedItems.join(', '));

  var detailFromLabels = detectDetailByLabels_(lines);
  if (detailFromLabels) detailBits.push(detailFromLabels);

  var detail = detailBits.join(' • ');
  if (recipient && !fuelGrade) detail = 'Transfer ke ' + recipient;
  if (!detail) detail = merchant && merchant !== 'Merchant' ? merchant : lines.slice(0, 3).join(' | ');

  var noteParts = [];
  if (recipient) noteParts.push('Ke: ' + recipient);
  var method = detectPaymentMethod_(lower);
  if (method) noteParts.push(method);
  if (!noteParts.length && fuelGrade) noteParts.push(fuelGrade);

  return {
    brand: merchant,
    category: category,
    amount: amountInfo.value,
    currency: currency,
    date: date,
    recipient: recipient,
    detail: detail,
    note: noteParts.join(' • '),
    fuelGrade: fuelGrade,
    liters: detectLitersSmart_(lines, normalized),
    pricePerL: detectFuelPricePerLSmart_(lines, normalized),
    confidence: {
      date: !!date,
      amount: amountInfo.confidence,
      currency: !!currency,
      recipient: !!recipient
    },
    rawSummary: lines.slice(0, 12).join(' | ')
  };
}

function normalizeOCRLine_(line) {
  return String(line || '')
    .replace(/[\u00A0\t]+/g, ' ')
    .replace(/[|¦]/g, 'I')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function normalizeOCRText_(text) {
  return String(text || '')
    .replace(/[\u00A0\t]+/g, ' ')
    .replace(/\r/g, '')
    .replace(/[|¦]/g, 'I')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function normalizeCurrency_(value) {
  var s = String(value || '').toUpperCase().trim();
  if (/^(RP|RUPIAH|IDR|RPH|RUPIAH INDONESIA)$/.test(s)) return 'IDR';
  if (/^(\$|USD|US DOLLAR|DOLLAR)$/.test(s)) return 'USD';
  if (/^(SGD|S\$|SINGAPORE DOLLAR)$/.test(s)) return 'SGD';
  if (/^(MYR|RM|RINGGIT)$/.test(s)) return 'MYR';
  if (/^(EUR|€|EURO)$/.test(s)) return 'EUR';
  if (/^(GBP|£|POUND)$/.test(s)) return 'GBP';
  if (/^(JPY|¥|YEN)$/.test(s)) return 'JPY';
  if (/^(AUD|A\$)$/.test(s)) return 'AUD';
  if (/^(CAD|C\$)$/.test(s)) return 'CAD';
  if (/^(THB|฿|BAHT)$/.test(s)) return 'THB';
  return 'IDR';
}

function detectCurrency_(lines, text) {
  var s = String(text || '').toUpperCase();
  if (/\bIDR\b|\bRUPIAH\b|\bRP\.?\s*[0-9]/.test(s)) return 'IDR';
  if (/SGD|S\$|SINGAPORE DOLLAR/.test(s)) return 'SGD';
  if (/MYR|RM\s*[0-9]|RINGGIT/.test(s)) return 'MYR';
  if (/EUR|€|EURO/.test(s)) return 'EUR';
  if (/GBP|£|POUND/.test(s)) return 'GBP';
  if (/JPY|¥|YEN/.test(s)) return 'JPY';
  if (/AUD|A\$/.test(s)) return 'AUD';
  if (/CAD|C\$/.test(s)) return 'CAD';
  if (/THB|฿|BAHT/.test(s)) return 'THB';
  if (/USD|US DOLLAR|DOLLAR|\$/.test(s)) return 'USD';
  return 'IDR';
}

function parseFlexibleDate_(raw) {
  var s = String(raw || '').trim().replace(/,/g, ' ');
  s = s.replace(/\b(jan(?:uari)?|january)\b/i, 'jan')
       .replace(/\b(feb(?:ruari)?|february)\b/i, 'feb')
       .replace(/\b(mar(?:et)?|march)\b/i, 'mar')
       .replace(/\b(apr(?:il)?|april)\b/i, 'apr')
       .replace(/\b(mei|may)\b/i, 'may')
       .replace(/\b(jun(?:i)?|june)\b/i, 'jun')
       .replace(/\b(jul(?:i)?|july)\b/i, 'jul')
       .replace(/\b(agu(?:stus)?|agustus|aug(?:ust)?)\b/i, 'aug')
       .replace(/\b(sep(?:tember)?|sept(?:ember)?)\b/i, 'sep')
       .replace(/\b(okt(?:ober)?|oct(?:ober)?)\b/i, 'oct')
       .replace(/\b(nov(?:ember)?)\b/i, 'nov')
       .replace(/\b(des(?:ember)?|dec(?:ember)?)\b/i, 'dec');

  var m = s.match(/\b(\d{1,2})[\s\/.\-](\d{1,2})[\s\/.\-](\d{2,4})\b/);
  if (m) {
    var d = Number(m[1]), mo = Number(m[2]), y = Number(m[3]);
    if (y < 100) y += 2000;
    if (y >= 2020 && y <= 2035 && d >= 1 && d <= 31 && mo >= 1 && mo <= 12) return Utilities.formatDate(new Date(y, mo - 1, d), TZ, 'yyyy-MM-dd');
  }
  var m2 = s.match(/\b(\d{1,2})\s+([a-z]{3})\s+(\d{2,4})\b/i);
  if (m2) {
    var months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
    var mo2 = months[m2[2].toLowerCase()], y2 = Number(m2[3]);
    if (y2 < 100) y2 += 2000;
    if (mo2 && y2 >= 2020 && y2 <= 2035 && Number(m2[1]) <= 31) return Utilities.formatDate(new Date(y2, mo2 - 1, Number(m2[1])), TZ, 'yyyy-MM-dd');
  }
  var m3 = s.match(/\b([a-z]{3})\s+(\d{1,2})\s+(\d{2,4})\b/i);
  if (m3) {
    var months2 = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
    var mo3 = months2[m3[1].toLowerCase()], y3 = Number(m3[3]);
    if (y3 < 100) y3 += 2000;
    if (mo3 && y3 >= 2020 && y3 <= 2035 && Number(m3[2]) <= 31) return Utilities.formatDate(new Date(y3, mo3 - 1, Number(m3[2])), TZ, 'yyyy-MM-dd');
  }
  return '';
}

function detectTransactionDate_(lines, text) {
  var dateWords = /(tanggal|tgl|date|transaction date|transaksi|waktu|time|dibuat|processed|settled|successful|berhasil|completed)/i;
  for (var i=0;i<lines.length;i++) {
    var line = lines[i];
    if (dateWords.test(line)) {
      var d = parseFlexibleDate_(line);
      if (d) return d;
      if (i + 1 < lines.length) { d = parseFlexibleDate_(lines[i+1]); if (d) return d; }
    }
  }
  var all = String(text || '');
  var candidates = all.match(/\b\d{1,2}[\s\/.\-]\d{1,2}[\s\/.\-]\d{2,4}\b/g) || [];
  for (var j=0;j<candidates.length;j++) { var dd=parseFlexibleDate_(candidates[j]); if(dd)return dd; }
  var monthCandidates = all.match(/\b\d{1,2}\s+(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\s+\d{2,4}\b/gi) || [];
  for (var k=0;k<monthCandidates.length;k++) { var dm=parseFlexibleDate_(monthCandidates[k]); if(dm)return dm; }
  return '';
}

function parseMoneyNumber_(raw, currency) {
  var s = String(raw || '').replace(/[^0-9,\.\-]/g, '');
  if (!s) return 0;
  var lastComma = s.lastIndexOf(','), lastDot = s.lastIndexOf('.');
  if (currency === 'IDR' || currency === 'JPY' || currency === 'KRW') {
    s = s.replace(/[,.](?=\d{3}(?:\D|$))/g, '').replace(/\D/g,'');
    return Number(s || 0);
  }
  if (lastComma > lastDot) {
    s = s.replace(/\./g,'').replace(',', '.');
  } else if (lastDot > lastComma) {
    var tail = s.length-lastDot-1;
    if (tail === 3 && lastComma < 0) s=s.replace(/\./g,'');
    else s=s.replace(/,/g,'');
  }
  return Number(s || 0);
}

function detectAmountSmart_(lines, text, currency) {
  var strong = /(total|grand total|jumlah|nominal|amount|total pembayaran|total bayar|dibayar|payment|paid|harga|nilai|debit|transfer|top up|topup|tarik tunai|withdrawal)/i;
  var negative = /(saldo|balance|saldo akhir|saldo awal|biaya admin|admin|fee|cashback|diskon|potongan|no\.? rekening|rekening|nomor|ref|kode|otp|tanggal|jam|waktu|pulsa|meter)/i;
  var best = null;
  var markers = currency === 'IDR' ? '(?:rp\.?|idr|rupiah)?' : '(?:usd|sgd|myr|eur|gbp|jpy|aud|cad|thb|\$|€|£|¥)?';
  for (var i=0;i<lines.length;i++) {
    var line=lines[i];
    var nums=line.match(/(?:RP|IDR|USD|SGD|MYR|EUR|GBP|JPY|AUD|CAD|THB|RM|\$|€|£|¥)?\s*[0-9][0-9.,]*/gi) || [];
    for (var j=0;j<nums.length;j++) {
      var raw=nums[j]; var v=parseMoneyNumber_(raw,currency);
      if (!(v>0)) continue;
      if (v > (currency==='IDR'?500000000:100000000)) continue;
      var score=0;
      if (strong.test(line)) score+=60;
      if (i>0 && /^(total|grand total|jumlah|nominal|amount|total pembayaran|total bayar|dibayar|payment|paid|debit|transfer|pembayaran)\s*[:=]?$/i.test(lines[i-1])) score+=60;
      if (/(rp|idr|rupiah|usd|sgd|myr|eur|gbp|jpy|aud|cad|thb|rm|\$|€|£|¥)/i.test(raw)) score+=35;
      if (negative.test(line)) score-=45;
      if (i >= lines.length-5) score+=8;
      if (/\b(debit|transfer|pembayaran)\b/i.test(line)) score+=15;
      if (!best || score>best.score || (score===best.score && v>best.value)) best={value:v,score:score,label:line};
    }
  }
  if (best) return {value:best.value,label:best.label,confidence:Math.max(0,Math.min(1,best.score/100))};
  return {value:0,label:'',confidence:0};
}

function detectRecipient_(lines, text) {
  var inlinePatterns=[
    /^(?:dikirim\s+kepada|dikirim\s+ke|ditransfer\s+kepada|ditransfer\s+ke|transfer\s+kepada|transfer\s+ke)\s*[:\-]?\s*(.+)$/i,
    /^(?:penerima|beneficiary|recipient|receiver|tujuan|nama\s+penerima|nama\s+tujuan|kepada|to)\s*[:\-]\s*(.+)$/i
  ];
  var exactLabels=/^(?:penerima|beneficiary|recipient|receiver|tujuan|nama\s+penerima|nama\s+tujuan|kepada|dikirim\s+ke|dikirim\s+kepada|ditransfer\s+ke|ditransfer\s+kepada|transfer\s+ke|transfer\s+kepada|to)$/i;

  for(var i=0;i<lines.length;i++){
    for(var j=0;j<inlinePatterns.length;j++){
      var m=lines[i].match(inlinePatterns[j]);
      if(m){
        var x=cleanPersonName_(m[1]);
        if(isPlausibleRecipient_(x)) return x;
      }
    }
    if(exactLabels.test(lines[i]) && i+1<lines.length){
      var y=cleanPersonName_(lines[i+1]);
      if(isPlausibleRecipient_(y)) return y;
    }
  }

  // Be conservative: do not treat every word after "ke" as a recipient.
  var transferContext=/(transfer|dikirim|ditransfer|penerima|beneficiary|recipient|tujuan|berhasil)/i.test(text||'');
  if(transferContext){
    for(var k=0;k<lines.length;k++){
      if(/^(?:[A-Z][A-Za-z'.-]+\s+){1,5}[A-Z][A-Za-z'.-]+$/.test(lines[k])){
        if(!/(seabank|bank|berhasil|success|transfer|transaksi|nominal|jumlah|saldo|balance)/i.test(lines[k])) return cleanPersonName_(lines[k]);
      }
    }
  }
  return '';
}

function isPlausibleRecipient_(x) {
  x=String(x||'').trim();
  if(!x || x.length<2 || x.length>100) return false;
  if(/^(seabank|bank|bca|mandiri|bri|bni|permata|cimb|btn|danamon|ocbc|uob|hsbc)$/i.test(x)) return false;
  if(/^(nominal|jumlah|amount|saldo|balance|tanggal|waktu|time|berhasil|success|completed|transfer)$/i.test(x)) return false;
  if(/^\d[\d\s.,/-]*$/.test(x)) return false;
  return /[A-Za-z]/.test(x);
}

function cleanPersonName_(s) {
  return String(s||'').replace(/^[\-:|]+|[\-:|]+$/g,'').replace(/\s{2,}/g,' ').trim().replace(/\s+(?:Rp|IDR|USD|Nominal|Jumlah|Amount)\b.*$/i,'').trim();
}

function detectMerchantSmart_(lines, text) {
  var bankLine='';
  for(var b=0;b<Math.min(lines.length,8);b++){
    if(/^\s*(seabank|bank\s+jago|bca|bri|bni|bank\s+mandiri|mandiri|cimb|permata|btn|danamon|ocbc|uob|hsbc)\b/i.test(lines[b])) { bankLine=lines[b].trim(); break; }
  }
  if(bankLine) return bankLine.replace(/[^a-zA-Z0-9 &.-]/g,'').trim();

  var header=/transaction|transaksi|berhasil|success|status|tanggal|tgl|waktu|time|nominal|jumlah|amount|saldo|balance|rekening|account|detail|catatan|penerima|recipient|beneficiary|tujuan|transfer|dikirim|completed/i;
  for(var i=0;i<Math.min(lines.length,10);i++){
    var l=lines[i];
    if(header.test(l)) continue;
    if(/^[-_=]+$/.test(l)) continue;
    if(/[A-Za-z]{3,}/.test(l) && !/\d{4,}/.test(l)){
      var c=l.replace(/[^a-zA-Z0-9 &.\-]/g,'').trim();
      if(c.length>=3 && !/^(Rp|IDR|USD|SGD|MYR|EUR|GBP|JPY|AUD|CAD|THB)$/i.test(c)) return c;
    }
  }
  var ig=text.match(/@([a-zA-Z0-9._-]+)/); if(ig)return ig[1].split('.')[0];
  return 'Merchant';
}

function detectDetailByLabels_(lines) {
  var re=/(?:keterangan|deskripsi|description|berita|pesan|catatan|detail|reference|referensi)\s*[:\-]\s*(.+)$/i;
  for(var i=0;i<lines.length;i++){var m=lines[i].match(re);if(m){var x=m[1].trim();if(x)return x;}}
  return '';
}

function detectPaymentMethod_(lower) {
  if(/qr|qris/.test(lower)) return 'QRIS';
  if(/virtual account|va\b/.test(lower)) return 'Virtual Account';
  if(/kartu kredit|credit card|visa|mastercard/.test(lower)) return 'Kartu Kredit';
  if(/debit/.test(lower)) return 'Debit';
  if(/transfer/.test(lower)) return 'Transfer';
  if(/tunai|cash/.test(lower)) return 'Tunai';
  return '';
}

function formatParsedMoney_(value, currency) {
  if(currency==='IDR') return 'Rp ' + Number(value||0).toLocaleString('id-ID');
  return currency + ' ' + Number(value||0).toLocaleString('en-US',{maximumFractionDigits:2});
}

function detectLitersSmart_(lines, text) {
  var m=String(text||'').match(/(?:liter|liters|literan|ltr|litre)\s*[:=]?\s*(\d+[\.,]?\d*)/i) || String(text||'').match(/(\d+[\.,]?\d*)\s*(?:liter|liters|ltr|litre)\b/i);
  return m ? Number(String(m[1]).replace(',','.')) : 0;
}

function detectFuelPricePerLSmart_(lines, text) {
  var m=String(text||'').match(/(?:harga\/l|harga per liter|price\/l|price per liter|per liter|\/l)\s*[:=]?\s*(?:rp\.?\s*)?([0-9.,]+)/i);
  if(!m)return 0;
  return parseMoneyNumber_(m[1],'IDR');
}

function detectMerchant_(lines, fullText) {
  if (!lines || !lines.length) return 'Merchant';

  for (var i = 0; i < Math.min(6, lines.length); i++) {
    var line = lines[i];
    var isHeaderJunk = /(reprint|welcome|selamat|kasir|waktu|tanggal|date|time|nota|bill|receipt|pembayaran|npwp|pos|powered)/i.test(line);
    var isPureNumber = /^[0-9.,:\-\s]+$/.test(line);

    if (!isHeaderJunk && !isPureNumber) {
      var cleanName = line.replace(/[^a-zA-Z0-9\s]/g, '').trim();
      if (cleanName.length >= 3) return cleanName;
    }
  }

  var igMatch = fullText.match(/@([a-zA-Z0-9._]+)/);
  if (igMatch) {
    var handle = igMatch[1].split('.')[0].replace(/[^a-zA-Z0-9]/g, '');
    if (handle.length >= 3) {
      return handle.charAt(0).toUpperCase() + handle.slice(1);
    }
  }

  return 'Merchant';
}

function extractDetailedItems_(lines) {
  var items = [];

  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    var qtyMatch = line.match(/(?:rp\.?\s*)?([\d.,]+)\s*x\s*(\d+)|(\d+)\s*x\s*(?:rp\.?\s*)?([\d.,]+)/i);

    if (qtyMatch) {
      var price = qtyMatch[1] || qtyMatch[4];
      var qty = qtyMatch[2] || qtyMatch[3];
      var itemName = '';

      if (i > 0) {
        var prevLine1 = lines[i - 1];
        if (!/(total|waktu|kasir|pembayaran|instagram|contact|reprint|subtotal|qris|cash)/i.test(prevLine1)) {
          itemName = prevLine1;

          if (i > 1) {
            var prevLine2 = lines[i - 2];
            if (/(ice|hot|large|regular|small|medium|level|less|normal|takeaway|dine in)/i.test(prevLine1)) {
              itemName = prevLine2 + ' (' + prevLine1 + ')';
            }
          }
        }
      }

      itemName = itemName.replace(/[^a-zA-Z0-9\s()]/g, '').trim();

      if (itemName) {
        var cleanPrice = price.replace(/[^0-9]/g, '');
        var formattedPrice = Number(cleanPrice).toLocaleString('id-ID');
        items.push(itemName + ' x' + qty + ' (Rp' + formattedPrice + ')');
      }
    }
  }

  return items;
}

function detectAmount_(text) {
  var str = String(text || '');

  var totalMatch = str.match(/(?:total|grand total|qris|bayar|amount|topup)\s*[:=]?\s*(?:rp\.?\s*)?([\d.,]+)/i);
  if (totalMatch) {
    var cleanNum = totalMatch[1].replace(/[^0-9]/g, '');
    var val = parseInt(cleanNum, 10);
    if (val >= 500) return val;
  }

  var matches = str.match(/(?:rp\.?|idr|\$)?\s*(\d{1,3}(?:[.,]\d{3})+|\d{4,})/gi);
  if (!matches) return 0;

  var numbers = matches
    .map(function(v) {
      var clean = v.replace(/[^0-9]/g, '');
      return Number(clean);
    })
    .filter(function(v) {
      return v >= 1000 && v <= 50000000;
    });

  if (!numbers.length) return 0;

  return Math.max.apply(null, numbers);
}

function detectCategory_(text) {
  if (/(pertamina|spbu|shell|vivo|bp\s*9[025]|bp92|bp95|pertamax|pertalite|dexlite|v-power|revvo|solar|bbm|bensin)/.test(text)) {
    return 'Bensin';
  }
  if (/(transfer|dikirim|ditransfer|penerima|beneficiary|recipient|seabank|bank\s+jago|bca|bri|bni|mandiri|cimb|permata)/.test(text)) {
    return 'Lainnya';
  }
  if (/(bengkel|tambal ban|ganti oli|service|ahass|planet ban|shop&drive|sparepart|onderdil|cuci|carwash|tune up|auto2000)/.test(text)) {
    return 'Servis';
  }
  if (/(\btol\b|e-?toll|gerbang tol|jasa marga)/.test(text)) {
    return 'Tol';
  }
  if (/(parkir|parking|valet)/.test(text)) {
    return 'Parkir';
  }
  if (/(coffee|latte|cappuccino|espresso|kopi|teh|tea|bakery|croissant|roti|resto|restaurant|cafe|kafe|warung|makan|minum|boba|ice cream|seafood|soto|bakso|nasi|ayam|mie|beverage|food|kitchen|eatery|diner|bar|catering)/.test(text)) {
    return 'Makan';
  }

  return 'Makan';
}

function detectFuelGrade_(lower) {
  var grades = [
    [/pertamax\s*turbo/, 'Pertamax Turbo'],
    [/pertamax\s*green/, 'Pertamax Green 95'],
    [/pertamax/, 'Pertamax'],
    [/pertalite/, 'Pertalite'],
    [/pertamina\s*dex/, 'Pertamina Dex'],
    [/dexlite/, 'Dexlite'],
    [/solar/, 'Solar'],
    [/v-power\s*nitro/, 'Shell V-Power Nitro+'],
    [/v-power/, 'Shell V-Power'],
    [/shell\s*super/, 'Shell Super'],
    [/shell\s*diesel/, 'Shell Diesel'],
    [/revvo\s*90/, 'Vivo Revvo 90'],
    [/revvo\s*92/, 'Vivo Revvo 92'],
    [/revvo\s*95/, 'Vivo Revvo 95'],
