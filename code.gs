function detectFuelGradeFromExpense_(e){return e.fuelGrade || detectFuelGrade_((e.detail||'')+' '+(e.brand||''));}
function getFuelEventsByVehicle_(expenses){
  var out={}; (expenses||[]).filter(function(e){return e.category==='Bensin'&&Number(e.liters||0)>0;}).forEach(function(e){var v=e.vehicle||'Motor'; if(!out[v])out[v]=[]; out[v].push(e);});
  Object.keys(out).forEach(function(v){out[v].sort(function(a,b){return String(a.ts||a.date).localeCompare(String(b.ts||b.date));});}); return out;
}
function fuelIntervalDistance_(trips,from,to,vehicle){
  var sum=0; (trips||[]).forEach(function(t){var tv=t.vehicle||'Motor'; if(tv!==vehicle)return; var ts=t.endTime||t.ts||t.date, a=new Date(from.ts||from.date), b=new Date(to.ts||to.date), tt=new Date(ts); if(!isNaN(a)&&!isNaN(b)&&!isNaN(tt)&&tt>a&&tt<=b)sum+=Number(t.distanceKm||0); else if(t.date>from.date&&t.date<=to.date)sum+=Number(t.distanceKm||0);}); return sum;
}
function calculateFuelInsightFast_(expenses,trips,today){
  var grouped=getFuelEventsByVehicle_(expenses), output={available:Object.keys(grouped).length>0,vehicles:{}};
  Object.keys(grouped).forEach(function(vehicle){
    var ev=grouped[vehicle], intervals=[];
    for(var i=1;i<ev.length;i++){
      var prev=ev[i-1], cur=ev[i];
      if(!prev.fullTank && !cur.fullTank && i>1)continue;
      var dist=fuelIntervalDistance_(trips,prev,cur,vehicle); var liters=Number(cur.liters||0);
      if(dist>0&&liters>0){var kmL=dist/liters; if(kmL>5&&kmL<100) intervals.push({kmL:kmL,distance:dist,liters:liters});}
    }
    var totalDist=intervals.reduce(function(s,x){return s+x.distance;},0), totalLiters=intervals.reduce(function(s,x){return s+x.liters;},0);
    var avg=totalLiters>0?totalDist/totalLiters:0, median=intervals.length?median_(intervals.map(function(x){return x.kmL;})):0;
    var last=ev[ev.length-1], since=fuelIntervalDistanceAfter_(trips,last,today,vehicle), daily=getRecentDailyKm_(trips,vehicle,14);
    var remain=avg>0&&last.fullTank?Math.max(0,Number(last.liters||0)*avg-since):0, daysLeft=daily>0?remain/daily:null;
    var confidence=intervals.length>=6?'sangat baik':intervals.length>=3?'baik':intervals.length===2?'cukup':'awal';
    output.vehicles[vehicle]={vehicle:vehicle,lastFillDate:last.date,lastLiters:Number(last.liters||0),lastFuelGrade:detectFuelGradeFromExpense_(last),avgKmL:avg,medianKmL:median,sinceKm:since,dailyKm:daily,remainingKm:remain,daysLeft:daysLeft,intervalCount:intervals.length,confidence:confidence};
  }); return output;
}
function median_(a){a=a.slice().sort(function(x,y){return x-y;}); if(!a.length)return 0; var m=Math.floor(a.length/2); return a.length%2?a[m]:(a[m-1]+a[m])/2;}
function fuelIntervalDistanceAfter_(trips,last,today,vehicle){var s=0; (trips||[]).forEach(function(t){if((t.vehicle||'Motor')!==vehicle)return; var tt=new Date(t.endTime||t.ts||t.date); var lt=new Date(last.ts||last.date); if(!isNaN(tt)&&!isNaN(lt)&&tt>lt&&t.date<=today)s+=Number(t.distanceKm||0); else if(t.date>last.date&&t.date<=today)s+=Number(t.distanceKm||0);}); return s;}
function getRecentDailyKm_(trips,vehicle,days){var d={};(trips||[]).forEach(function(t){if((t.vehicle||'Motor')!==vehicle)return;var cutoff=new Date(Date.now()-days*86400000), tt=new Date(t.endTime||t.ts||t.date);if(tt>=cutoff){d[t.date]=(d[t.date]||0)+Number(t.distanceKm||0);}});var keys=Object.keys(d);if(!keys.length)return 0;return keys.reduce(function(s,k){return s+d[k];},0)/Math.max(keys.length,1);}
function getBestEfficiencyForTrip_(trip,insight){var v=trip.vehicle||'Motor', x=insight&&insight.vehicles&&insight.vehicles[v]; if(x&&x.avgKmL>0)return x.avgKmL; return Number(trip.fuelEfficiency||0);}
function analyzeTripRecord_(values){
  var expenses=getExpensesFast_(RECENT_ANALYTICS_EXPENSE_LIMIT), trips=getTripsFast_(RECENT_ANALYTICS_TRIP_LIMIT);
  var insight=calculateFuelInsightFast_(expenses,trips,todayStr_()), vehicle=values.Kendaraan||'Motor', eff=insight.vehicles[vehicle]&&insight.vehicles[vehicle].avgKmL||0;
  return {fuelEfficiency:eff,estimatedLiters:eff>0?Number(values.Jarak_km||0)/eff:0,routeVariant:values.RouteVariant||'',confidence:insight.vehicles[vehicle]?insight.vehicles[vehicle].confidence:'belum ada'};
}
function buildDailyInsightObject_(expenses,trips){
  var today=todayStr_(), weekStart=Utilities.formatDate(new Date(Date.now()-7*86400000),TZ,'yyyy-MM-dd');
  var last7=(trips||[]).filter(function(t){return t.date>=weekStart&&t.date<=today;});
  var dist=last7.reduce(function(s,t){return s+Number(t.distanceKm||0);},0), moving=last7.reduce(function(s,t){return s+Number(t.movingTimeMin||t.durationMin||0);},0), duration=last7.reduce(function(s,t){return s+Number(t.durationMin||0);},0);
  var insight=calculateFuelInsightFast_(expenses,trips,today), efficiencies=[];Object.keys(insight.vehicles).forEach(function(v){if(insight.vehicles[v].avgKmL>0)efficiencies.push(insight.vehicles[v].avgKmL);});
  var avgEff=efficiencies.length?efficiencies.reduce(function(a,b){return a+b;},0)/efficiencies.length:0;
  var routes={}; last7.forEach(function(t){var k=t.routeVariant||t.routeName||'GPS'; if(!routes[k])routes[k]={count:0,dur:0,dist:0};routes[k].count++;routes[k].dur+=Number(t.durationMin||0);routes[k].dist+=Number(t.distanceKm||0);});
  var best='';Object.keys(routes).forEach(function(k){if(!best||routes[k].count>routes[best].count)best=k;});
