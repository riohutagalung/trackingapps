const EXP_H = [
  'ID', 'Tanggal', 'Kategori', 'Brand', 'Detail', 'Jumlah', 'Catatan', 'Sumber', 'Timestamp',
  'Liter', 'Kendaraan', 'ReceiptURL', 'FuelGrade', 'FuelPricePerL', 'FuelRefPricePerL', 'FuelRefDate', 'FullTank', 'Odometer_km', 'MataUang'
];

function ensureExpenseColumns_(sheet) {
  var lastCol = Math.max(sheet.getLastColumn(), 1);
  var existing = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  EXP_H.forEach(function(header) {
    if (existing.indexOf(header) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(header);
      existing.push(header);
    }
  });
}

function getHeaderMap_(headers) {
  var map = {};
  headers.forEach(function(h, i) { map[String(h)] = i; });
  return map;
}

function addExpense(data) {
  data = data || {};
  var sheet = tab_('Expenses', EXP_H);
  ensureExpenseColumns_(sheet); // only on write, never on boot/read
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var map = getHeaderMap_(headers);
  var row = new Array(headers.length).fill('');
  var id = data.id || Utilities.getUuid().slice(0, 8);
  var category = String(data.category || 'Lainnya');
  var brand = String(data.brand || '').trim();
  var detail = String(data.detail || '');
  var note = String(data.note || '');
  var currency = normalizeCurrency_(data.currency || 'IDR');
  var fuelGrade = String(data.fuelGrade || '').trim();
  var fuelText = (category + ' ' + brand + ' ' + detail + ' ' + note + ' ' + fuelGrade).toLowerCase();
  if (/\b(shell|bp|vivo|pertamina|pertamax|pertalite|dexlite|biosolar|solar|spbu|bbm|bensin|revvo|v-power)\b/.test(fuelText)) category = 'Bensin';
  if (category === 'Bensin' && !brand) {
    var fm = fuelText.match(/\b(shell|bp|vivo|pertamina)\b/i);
    if (fm) brand = fm[1];
  }
  if (category === 'Bensin' && !fuelGrade) fuelGrade = detectFuelGrade_(fuelText);
  var amount = Number(data.amount || 0);
  var liters = Number(data.liters || 0);
  var explicitPrice = Number(data.fuelPricePerL || 0);
  var ref = getFuelReferencePrice_(fuelGrade || detail || brand, data.date || todayStr_());
  var refPrice = Number(ref.price || 0);
  if (category === 'Bensin' && liters <= 0 && amount > 0 && explicitPrice > 0) liters = amount / explicitPrice;
  if (category === 'Bensin' && liters <= 0 && amount > 0 && refPrice > 0) liters = amount / refPrice;
  var values = {
    'ID': id,
    'Tanggal': data.date || todayStr_(),
    'Kategori': category,
    'Brand': brand,
    'Detail': detail,
    'Jumlah': amount,
    'Catatan': note,
    'Sumber': data.source || 'manual',
    'Timestamp': nowISO_(),
    'Liter': liters,
    'Kendaraan': data.vehicle || (category === 'Bensin' ? 'Motor' : ''),
    'ReceiptURL': data.receiptUrl || '',
    'FuelGrade': category === 'Bensin' ? fuelGrade : '',
    'FuelPricePerL': category === 'Bensin' ? (explicitPrice || (liters > 0 && amount > 0 ? amount / liters : 0)) : 0,
    'FuelRefPricePerL': category === 'Bensin' ? refPrice : 0,
    'FuelRefDate': category === 'Bensin' ? (ref.effectiveDate || '') : '',
    'FullTank': category === 'Bensin' ? !!data.fullTank : false,
    'Odometer_km': category === 'Bensin' ? Number(data.odometerKm || 0) : 0,
    'MataUang': currency
  };
  Object.keys(values).forEach(function(key) { if (map[key] !== undefined) row[map[key]] = values[key]; });
  sheet.appendRow(row);
  try { var r = sheet.getLastRow(); if(map['Jumlah']!==undefined) sheet.getRange(r,map['Jumlah']+1).setNumberFormat('#,##0'); if(map['Liter']!==undefined) sheet.getRange(r,map['Liter']+1).setNumberFormat('0.00'); if(map['FuelPricePerL']!==undefined) sheet.getRange(r,map['FuelPricePerL']+1).setNumberFormat('#,##0'); } catch(e) {}
  invalidateEngineCache_();
  return {ok:true, id:id, fuel:{category:category, fuelGrade:fuelGrade, liters:liters, pricePerL:values['FuelPricePerL'], referencePricePerL:refPrice, referenceDate:ref.effectiveDate||'', fullTank:!!data.fullTank}};
}

function rowToExpense_(row, map) {
  return {
    id: map['ID'] !== undefined ? row[map['ID']] : '',
    date: dateStr_(map['Tanggal'] !== undefined ? row[map['Tanggal']] : ''),
    category: String(map['Kategori'] !== undefined ? (row[map['Kategori']] || '') : ''),
    brand: String(map['Brand'] !== undefined ? (row[map['Brand']] || '') : ''),
    detail: String(map['Detail'] !== undefined ? (row[map['Detail']] || '') : ''),
    amount: Number(map['Jumlah'] !== undefined ? (row[map['Jumlah']] || 0) : 0),
    note: String(map['Catatan'] !== undefined ? (row[map['Catatan']] || '') : ''),
    source: String(map['Sumber'] !== undefined ? (row[map['Sumber']] || '') : ''),
    ts: String(map['Timestamp'] !== undefined ? (row[map['Timestamp']] || '') : ''),
    liters: Number(map['Liter'] !== undefined ? (row[map['Liter']] || 0) : 0),
    vehicle: String(map['Kendaraan'] !== undefined ? (row[map['Kendaraan']] || '') : ''),
    receiptUrl: String(map['ReceiptURL'] !== undefined ? (row[map['ReceiptURL']] || '') : ''),
    fuelGrade: String(map['FuelGrade'] !== undefined ? (row[map['FuelGrade']] || '') : ''),
    fuelPricePerL: Number(map['FuelPricePerL'] !== undefined ? (row[map['FuelPricePerL']] || 0) : 0),
    fuelRefPricePerL: Number(map['FuelRefPricePerL'] !== undefined ? (row[map['FuelRefPricePerL']] || 0) : 0),
    fuelRefDate: dateStr_(map['FuelRefDate'] !== undefined ? (row[map['FuelRefDate']] || '') : ''),
    fullTank: map['FullTank'] !== undefined ? (row[map['FullTank']] === true || String(row[map['FullTank']]).toLowerCase() === 'true' || String(row[map['FullTank']]).toLowerCase() === 'ya' || String(row[map['FullTank']]).toLowerCase() === 'yes') : false,
    odometerKm: Number(map['Odometer_km'] !== undefined ? (row[map['Odometer_km']] || 0) : 0),
    currency: normalizeCurrency_(map['MataUang'] !== undefined ? (row[map['MataUang']] || 'IDR') : 'IDR')
  };
}

function getExpenses(limit){ return getExpensesFast_(limit || BOOT_EXPENSE_LIMIT); }

function getExpensesSince(days, limit) {
  var sheet = tab_('Expenses', EXP_H);
  ensureExpenseColumns_(sheet);
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return [];

  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var map = getHeaderMap_(headers);
  var cutoff = new Date(Date.now() - Number(days || 90) * 86400000);
  var cutoffStr = Utilities.formatDate(cutoff, TZ, 'yyyy-MM-dd');

  // Karena transaksi append-only, cari dari bawah dengan membaca kolom Tanggal saja.
  var dates = sheet.getRange(2, map['Tanggal'] + 1, lastRow - 1, 1).getValues();
  var startIdx = 0;
  for (var i = dates.length - 1; i >= 0; i--) {
    if (dateStr_(dates[i][0]) < cutoffStr) { startIdx = i + 1; break; }
  }
  var startRow = 2 + startIdx;
  var count = lastRow - startRow + 1;
  if (count <= 0) return [];
  if (limit) { count = Math.min(count, Number(limit)); startRow = lastRow - count + 1; }

  var rows = sheet.getRange(startRow, 1, count, headers.length).getValues();
  return rows.map(function(row) { return rowToExpense_(row, map); }).reverse()
    .filter(function(x) { return x.date >= cutoffStr; });
}

function getExpenseHistory(filters) {
  filters = filters || {};
  var sheet = tab_('Expenses', EXP_H);
  ensureExpenseColumns_(sheet);
  if (sheet.getLastRow() <= 1) return [];
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var map = getHeaderMap_(headers);
  var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues();
  var from = String(filters.from || '');
  var to = String(filters.to || '');
  var category = String(filters.category || '');
  return rows.map(function(row) { return rowToExpense_(row, map); }).reverse().filter(function(e) {
    return (!from || e.date >= from) && (!to || e.date <= to) && (!category || e.category === category);
  });
}

function deleteExpense(id) {
  var sheet = tab_(
    'Expenses',
    EXP_H
  );

  var rows = sheet
    .getDataRange()
    .getValues();

  for (
    var i = 1;
    i < rows.length;
    i++
  ) {
    if (
      String(rows[i][0]) ===
      String(id)
    ) {
      sheet.deleteRow(i + 1);
      return {
        ok: true
      };
    }
  }

  return {
    ok: false,
    error: 'Data tidak ditemukan'
  };
}

